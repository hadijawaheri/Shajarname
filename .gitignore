# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Package managers (monorepo uses pnpm) ───────────────────────────────────
package-lock.json
yarn.lock
**/pnpm-lock.yaml
!pnpm-lock.yaml

# ── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
.next/
out/
.turbo/

# ── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# Next.js generated types (regenerated on install/build)
**/next-env.d.ts

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Logs & debug ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test / coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Deploy ───────────────────────────────────────────────────────────────────
.vercel/

# ── Puppeteer / browser caches ───────────────────────────────────────────────
.cache/

# ── TLS keys ────────────────────────────────────────────────────────────────
*.pem
!ssl/.gitkeep
!ssl/README.md

# ── User uploads (runtime data, not source) ─────────────────────────────────
shajarname-back/public/avatars/*
!shajarname-back/public/avatars/.gitkeep
shajarname-back/public/gallery/photos/*
!shajarname-back/public/gallery/photos/.gitkeep
shajarname-back/public/gallery/audio/*
!shajarname-back/public/gallery/audio/.gitkeep

# ── Misc ─────────────────────────────────────────────────────────────────────
*.pid
*.seed
